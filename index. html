<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>⚡ 𝛩𝑺𝐾𝐴-𝐵𝛩𝑇 - البوت الملكي الرسمي</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        :root {
            --bg: #050608;
            --card: #0d1117;
            --cyan: #00f2fe;
            --blue: #4facfe;
            --purple: #7f00ff;
            --text: #a9b2c3;
            --white: #ffffff;
            --glow: 0 0 15px rgba(0,242,254,0.4);
        }
        *{box-sizing:border-box;margin:0;padding:0;font-family:'Tajawal',sans-serif;scroll-behavior:smooth}
        body{background:var(--bg);color:var(--text);overflow-x:hidden;line-height:1.6}

        #particles-canvas{position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;pointer-events:none}
        .grid-bg{position:fixed;top:0;left:0;width:100%;height:100%;
            background-image:linear-gradient(rgba(0,242,254,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(0,242,254,.02) 1px,transparent 1px);
            background-size:50px 50px;z-index:-2}

        /* NAV */
        nav{position:fixed;top:0;left:0;width:100%;background:rgba(5,6,8,.92);backdrop-filter:blur(18px);z-index:1000;
            border-bottom:2px solid;border-image:linear-gradient(90deg,transparent,var(--cyan),var(--purple),transparent) 1}
        .nav-container{max-width:1200px;margin:0 auto;padding:13px 24px;display:flex;justify-content:space-between;align-items:center;gap:20px}
        .logo{font-size:22px;font-weight:900;color:var(--white);text-decoration:none;display:flex;align-items:center;gap:8px}
        .logo span{background:linear-gradient(45deg,var(--cyan),var(--blue));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .nav-links{display:flex;list-style:none;gap:6px;align-items:center}
        .nav-links a{color:var(--text);text-decoration:none;font-weight:600;font-size:13.5px;padding:8px 13px;border-radius:8px;
            transition:.3s;display:flex;align-items:center;gap:6px;white-space:nowrap;border:1px solid transparent}
        .nav-links a:hover,.nav-links a.active{color:var(--white);background:rgba(0,242,254,.07);border-color:rgba(0,242,254,.15)}
        .hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:6px;background:rgba(255,255,255,.04);
            border:1px solid rgba(0,242,254,.2);border-radius:8px}
        .hamburger span{width:22px;height:2px;background:var(--cyan);border-radius:2px;transition:.3s}
        .hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
        .hamburger.open span:nth-child(2){opacity:0}
        .hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
        .mobile-nav{display:none;position:fixed;top:65px;left:0;width:100%;background:rgba(5,6,8,.98);
            backdrop-filter:blur(20px);z-index:999;border-bottom:1px solid rgba(0,242,254,.15);padding:16px;
            flex-direction:column;gap:6px}
        .mobile-nav.open{display:flex}
        .mobile-nav a,.mobile-nav button{display:flex;align-items:center;gap:10px;color:var(--text);text-decoration:none;
            font-size:15px;padding:12px 16px;border-radius:10px;border:1px solid transparent;transition:.3s;
            background:none;cursor:pointer;width:100%;font-family:'Tajawal',sans-serif}
        .mobile-nav a:hover,.mobile-nav button:hover{color:var(--white);background:rgba(0,242,254,.06);border-color:rgba(0,242,254,.15)}

        /* MODAL */
        .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);z-index:3000;
            display:none;align-items:center;justify-content:center}
        .modal-overlay.show{display:flex;animation:fadeIn .25s ease}
        .modal-box{background:#0d1117;border:1px solid rgba(0,242,254,.3);border-radius:20px;padding:40px 36px;
            width:100%;max-width:420px;box-shadow:0 20px 60px rgba(0,0,0,.6),var(--glow);text-align:center;position:relative}
        .modal-box h2{color:var(--white);font-size:22px;margin-bottom:8px}
        .modal-box p{font-size:14px;margin-bottom:28px}
        .modal-icon{font-size:48px;margin-bottom:16px;display:block}
        .modal-input-wrap{position:relative;margin-bottom:20px}
        .modal-input{width:100%;padding:13px 48px 13px 16px;background:#141b24;border:1px solid rgba(0,242,254,.2);
            border-radius:10px;color:var(--white);font-size:15px;font-family:'Tajawal',sans-serif;transition:.3s;outline:none}
        .modal-input:focus{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(0,242,254,.08)}
        .modal-eye{position:absolute;left:14px;top:50%;transform:translateY(-50%);background:none;border:none;
            color:var(--text);cursor:pointer;font-size:16px;transition:.2s}
        .modal-eye:hover{color:var(--cyan)}
        .modal-btns{display:flex;gap:12px}
        .modal-close-btn{flex:1;padding:12px;border-radius:10px;background:rgba(255,255,255,.04);
            border:1px solid rgba(255,255,255,.1);color:var(--text);cursor:pointer;font-family:'Tajawal',sans-serif;font-size:14px;transition:.3s}
        .modal-close-btn:hover{background:rgba(255,255,255,.08);color:var(--white)}
        .modal-submit-btn{flex:2;padding:12px;border-radius:10px;background:linear-gradient(45deg,var(--cyan),var(--blue));
            border:none;color:#040506;cursor:pointer;font-family:'Tajawal',sans-serif;font-size:15px;font-weight:700;transition:.3s}
        .modal-submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,242,254,.3)}
        .modal-error{color:#ff4d6d;font-size:13px;margin-top:-12px;margin-bottom:14px;display:none}

        /* HERO */
        .hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;
            padding:120px 20px 60px;position:relative}
        .hero-video-wrapper{width:100%;max-width:900px;border-radius:20px;overflow:hidden;border:2px solid rgba(0,242,254,.2);
            box-shadow:0 0 60px rgba(0,242,254,.12);margin-bottom:60px;position:relative;background:#000}
        .hero-video-placeholder{width:100%;height:320px;display:flex;flex-direction:column;align-items:center;justify-content:center;
            background:linear-gradient(135deg,#0d1117,#0a1628);color:var(--text);gap:16px}
        .hero-video-placeholder i{font-size:60px;color:var(--cyan);opacity:.4}
        .video-label{position:absolute;top:16px;right:16px;background:rgba(0,0,0,.7);color:var(--cyan);
            font-size:12px;padding:4px 12px;border-radius:20px;border:1px solid rgba(0,242,254,.2)}
        .step-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(0,242,254,.08);color:var(--cyan);
            font-size:12px;padding:5px 12px;border-radius:20px;border:1px solid rgba(0,242,254,.15);margin-top:8px}
        .hero-main{display:flex;align-items:center;justify-content:space-between;gap:50px;width:100%;max-width:1200px}
        .hero-content{flex:1}
        .hero-image-wrapper{flex:1;display:flex;justify-content:center;align-items:center;animation:float 6s ease-in-out infinite}
        .hero-image-container{width:300px;height:300px;border-radius:50%;padding:7px;
            background:linear-gradient(45deg,var(--cyan),var(--blue),var(--purple),var(--cyan));
            background-size:300% 300%;animation:glowBreath 4s infinite alternate,gradientShift 8s ease infinite}
        .hero-img{width:100%;height:100%;border-radius:50%;object-fit:cover;border:5px solid #0d1117}

        @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
        @keyframes glowBreath{0%{box-shadow:0 0 20px rgba(0,242,254,.4)}100%{box-shadow:0 0 50px rgba(127,0,255,.7),0 0 80px rgba(0,242,254,.5)}}
        @keyframes gradientShift{0%{background-position:0 50%}50%{background-position:100% 50%}100%{background-position:0 50%}}
        @keyframes fadeIn{from{opacity:0}to{opacity:1}}
        @keyframes slideDown{from{opacity:0;transform:translateY(-12px)}to{opacity:1;transform:translateY(0)}}
        @keyframes slideUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

        .badge{background:rgba(0,242,254,.08);color:var(--cyan);padding:9px 18px;border-radius:50px;font-size:13px;
            font-weight:700;display:inline-flex;align-items:center;gap:7px;margin-bottom:22px;border:1px solid rgba(0,242,254,.2)}
        .hero-title{font-size:44px;font-weight:900;color:var(--white);margin-bottom:18px;line-height:1.2}
        .hero-title span{background:linear-gradient(45deg,var(--cyan),var(--blue));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .hero-desc{font-size:17px;margin-bottom:36px}
        .btn-group{display:flex;gap:14px;flex-wrap:wrap}
        .btn{padding:13px 30px;border-radius:10px;font-weight:700;text-decoration:none;transition:.3s;
            display:inline-flex;align-items:center;gap:9px;font-size:15px;cursor:pointer;border:none;font-family:'Tajawal',sans-serif}
        .btn-primary{background:linear-gradient(45deg,var(--cyan),var(--blue));color:#040506;box-shadow:0 4px 20px rgba(0,242,254,.3)}
        .btn-primary:hover{transform:translateY(-4px);box-shadow:0 8px 25px rgba(0,242,254,.5)}
        .btn-secondary{background:rgba(255,255,255,.03);color:var(--white);border:1px solid rgba(255,255,255,.1)!important}
        .btn-secondary:hover{border-color:var(--cyan)!important;transform:translateY(-4px)}

        /* SECTIONS */
        section{padding:80px 20px;max-width:1200px;margin:0 auto}
        .section-header{text-align:center;margin-bottom:50px}
        .section-badge{color:var(--cyan);font-size:12px;font-weight:700;background:rgba(0,242,254,.05);
            padding:5px 14px;border-radius:30px;border:1px solid rgba(0,242,254,.1)}
        .section-title{font-size:34px;color:var(--white);margin-top:10px}
        .section-title span{background:linear-gradient(45deg,var(--cyan),var(--blue));-webkit-background-clip:text;-webkit-text-fill-color:transparent}

        /* INSTALL STEPS */
        .install-steps{display:flex;flex-direction:column;gap:20px;max-width:750px;margin:0 auto}
        .step-card{background:var(--card);border:1px solid rgba(255,255,255,.05);border-radius:16px;padding:28px 32px;
            display:flex;align-items:flex-start;gap:24px;position:relative;overflow:hidden;transition:.3s}
        .step-card::before{content:'';position:absolute;top:0;right:0;width:4px;height:100%;
            background:linear-gradient(180deg,var(--cyan),var(--purple))}
        .step-card:hover{transform:translateX(-6px);border-color:rgba(0,242,254,.2);box-shadow:0 8px 30px rgba(0,242,254,.07)}
        .step-num{width:50px;height:50px;min-width:50px;border-radius:50%;background:linear-gradient(45deg,var(--cyan),var(--blue));
            display:flex;align-items:center;justify-content:center;color:#040506;font-size:20px;font-weight:900}
        .step-content h3{color:var(--white);font-size:17px;margin-bottom:8px}
        .step-content p{font-size:14px;line-height:1.7}
        .step-content .step-action{margin-top:16px}
        .connector{width:2px;height:24px;background:linear-gradient(var(--cyan),var(--purple));margin-right:41px}

        /* DEPLOY */
        .deploy-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px;margin-top:30px}
        .deploy-card{background:var(--card);border:1px solid rgba(255,255,255,.05);border-radius:16px;padding:28px;
            transition:.3s;position:relative;overflow:hidden}
        .deploy-card::before{content:'';position:absolute;top:0;left:0;width:100%;height:3px;
            background:linear-gradient(90deg,var(--cyan),var(--blue))}
        .deploy-card:hover{transform:translateY(-7px);border-color:var(--cyan);box-shadow:0 10px 30px rgba(0,242,254,.1)}
        .deploy-card h3{color:var(--white);margin-bottom:12px;display:flex;align-items:center;gap:8px;font-size:16px}
        .deploy-card p{font-size:13.5px;margin-bottom:22px;min-height:55px}

        /* FEATURES */
        .features-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:22px}
        .feature-card{background:var(--card);padding:38px 28px;border-radius:16px;transition:.3s;
            border:1px solid rgba(255,255,255,.02);text-align:center}
        .feature-card:hover{transform:translateY(-9px);border-color:rgba(0,242,254,.2);box-shadow:0 15px 35px rgba(0,242,254,.07)}
        .feature-icon-wrapper{width:68px;height:68px;background:rgba(0,242,254,.05);border-radius:50%;
            display:flex;align-items:center;justify-content:center;margin:0 auto 18px;border:1px solid rgba(0,242,254,.1)}
        .feature-icon{font-size:27px;background:linear-gradient(45deg,var(--cyan),var(--blue));
            -webkit-background-clip:text;-webkit-text-fill-color:transparent}

        /* DEVELOPER */
        .dev-card{background:var(--card);border-radius:20px;max-width:520px;margin:0 auto;padding:46px 28px;
            text-align:center;border:1px solid rgba(0,242,254,.08)}
        .dev-avatar{width:110px;height:110px;border-radius:50%;background:linear-gradient(45deg,var(--cyan),var(--blue));
            display:flex;align-items:center;justify-content:center;font-size:46px;color:#040506;margin:0 auto 22px}

        /* OWNER PANEL */
        .owner-panel-wrapper{max-width:900px;margin:40px auto;display:none}
        .owner-panel-wrapper.active{display:block;animation:slideUp .4s ease}
        .owner-panel{background:#090d14;border:2px solid rgba(0,242,254,.35);border-radius:24px;overflow:hidden;
            box-shadow:0 20px 60px rgba(0,0,0,.5),var(--glow)}
        .owner-panel-header{background:linear-gradient(90deg,rgba(0,242,254,.08),rgba(127,0,255,.08));
            padding:28px 36px;border-bottom:1px solid rgba(0,242,254,.15);display:flex;align-items:center;justify-content:space-between}
        .owner-panel-header h2{color:var(--white);font-size:20px;display:flex;align-items:center;gap:10px}
        .panel-close{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:var(--text);
            width:36px;height:36px;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;
            transition:.2s;font-size:16px}
        .panel-close:hover{background:rgba(255,77,109,.15);border-color:rgba(255,77,109,.3);color:#ff4d6d}
        .panel-tabs{display:flex;border-bottom:1px solid rgba(255,255,255,.06)}
        .panel-tab{flex:1;padding:16px 20px;background:none;border:none;color:var(--text);cursor:pointer;font-family:'Tajawal',sans-serif;
            font-size:14px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:8px;transition:.25s;
            border-bottom:2px solid transparent;margin-bottom:-1px}
        .panel-tab:hover{color:var(--white);background:rgba(0,242,254,.03)}
        .panel-tab.active{color:var(--cyan);border-bottom-color:var(--cyan);background:rgba(0,242,254,.04)}
        .tab-content{display:none;padding:32px 36px;animation:fadeIn .3s ease}
        .tab-content.active{display:block}
        .field-group{margin-bottom:22px}
        .field-group label{display:block;color:var(--white);font-weight:700;font-size:14px;margin-bottom:8px}
        .field-group label i{color:var(--cyan);margin-left:6px}
        .owner-input{width:100%;padding:12px 16px;background:#141b24;border:1px solid rgba(0,242,254,.15);
            border-radius:10px;color:var(--white);font-size:14px;font-family:'Tajawal',sans-serif;transition:.3s;outline:none}
        .owner-input:focus{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(0,242,254,.08)}
        textarea.owner-input{resize:vertical;min-height:80px}
        .owner-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
        .owner-grid-2>.field-group{margin-bottom:0}
        .save-btn{width:100%;padding:14px;border-radius:12px;background:linear-gradient(45deg,var(--cyan),var(--blue));
            border:none;color:#040506;font-family:'Tajawal',sans-serif;font-size:16px;font-weight:700;cursor:pointer;
            display:flex;align-items:center;justify-content:center;gap:10px;margin-top:28px;transition:.3s}
        .save-btn:hover{transform:translateY(-3px);box-shadow:0 8px 25px rgba(0,242,254,.35)}
        .security-info{background:rgba(0,242,254,.04);border:1px solid rgba(0,242,254,.12);border-radius:12px;
            padding:18px 20px;margin-bottom:24px;display:flex;gap:12px;align-items:flex-start}
        .security-info i{color:var(--cyan);font-size:18px;margin-top:2px}
        .security-info p{font-size:13.5px;line-height:1.6}
        .password-input-wrap{position:relative}
        .password-input-wrap .owner-input{padding-left:44px}
        .toggle-eye{position:absolute;left:14px;top:50%;transform:translateY(-50%);background:none;border:none;
            color:var(--text);cursor:pointer;font-size:15px;transition:.2s}
        .toggle-eye:hover{color:var(--cyan)}

        /* AI CHAT */
        .ai-chat-trigger{position:fixed;bottom:26px;right:26px;width:58px;height:58px;border-radius:50%;
            background:linear-gradient(45deg,var(--cyan),var(--blue));box-shadow:0 0 20px rgba(0,242,254,.4);
            display:flex;align-items:center;justify-content:center;color:#000;font-size:23px;cursor:pointer;z-index:999;transition:.3s}
        .ai-chat-trigger:hover{transform:scale(1.1) rotate(15deg)}
        .ai-chat-widget{position:fixed;bottom:96px;right:26px;width:340px;height:420px;
            background:rgba(13,17,23,.96);border:1px solid rgba(0,242,254,.25);border-radius:18px;
            box-shadow:0 12px 40px rgba(0,0,0,.6),var(--glow);z-index:998;display:none;flex-direction:column;overflow:hidden;backdrop-filter:blur(12px)}
        .ai-chat-header{background:linear-gradient(45deg,var(--cyan),var(--blue));padding:14px 16px;color:#000;font-weight:700;
            display:flex;justify-content:space-between;align-items:center;font-size:14px}
        .ai-chat-messages{flex:1;padding:14px;overflow-y:auto;display:flex;flex-direction:column;gap:9px;font-size:13px}
        .message{padding:9px 13px;border-radius:12px;max-width:82%;line-height:1.5}
        .message.bot{background:rgba(255,255,255,.05);align-self:flex-start;color:var(--white)}
        .message.user{background:var(--cyan);color:#000;align-self:flex-end}
        .ai-chat-input-area{display:flex;border-top:1px solid rgba(255,255,255,.05);padding:10px;background:rgba(5,6,8,.9)}
        .ai-chat-input{flex:1;background:transparent;border:none;color:#fff;padding:5px 10px;outline:none;font-family:'Tajawal',sans-serif}
        .ai-chat-send{background:none;border:none;color:var(--cyan);cursor:pointer;font-size:16px;padding:0 10px}

        /* MUSIC */
        .music-widget{position:fixed;bottom:26px;left:26px;background:rgba(13,17,23,.9);
            border:1px solid rgba(0,242,254,.18);padding:11px 18px;border-radius:50px;
            display:flex;align-items:center;gap:13px;z-index:997;box-shadow:0 8px 32px rgba(0,0,0,.5);backdrop-filter:blur(10px)}
        .music-btn{background:none;border:none;color:var(--cyan);cursor:pointer;font-size:15px}
        .music-info{display:flex;flex-direction:column;font-size:11px}
        .music-title{color:var(--white);font-weight:700}

        footer{background:#030405;padding:50px 20px;text-align:center;border-top:1px solid rgba(255,255,255,.03);margin-top:60px}

        @media(max-width:900px){
            .hero-main{flex-direction:column;text-align:center}
            .btn-group{justify-content:center}
            .hero-image-container{width:240px;height:240px}
            .nav-links{display:none}
            .hamburger{display:flex}
            .owner-grid-2{grid-template-columns:1fr}
        }
        @media(max-width:600px){
            .hero-title{font-size:30px}
            .tab-content{padding:24px 20px}
            .owner-panel-header{padding:20px}
            .panel-tab{font-size:12px;padding:12px 8px}
        }
    </style>
</head>
<body>
<canvas id="particles-canvas"></canvas>
<div class="grid-bg"></div>

<!-- NAV -->
<nav>
    <div class="nav-container">
        <a href="#home" class="logo" id="main-logo"><span>⚡ 𝛩𝑺𝐾𝐴-𝐵𝛩𝑇</span></a>
        <ul class="nav-links">
            <li><a href="#home"><i class="fa-solid fa-house"></i> الرئيسية</a></li>
            <li><a href="#install"><i class="fa-solid fa-terminal"></i> التنصيب</a></li>
            <li><a href="#deploy"><i class="fa-solid fa-cloud-arrow-up"></i> التشغيل</a></li>
            <li><a href="#features"><i class="fa-solid fa-bolt"></i> المميزات</a></li>
            <li><a href="#developer"><i class="fa-solid fa-user-ninja"></i> المطور</a></li>
            <li><a href="#" onclick="openOwnerModal(event)"><i class="fa-solid fa-shield-halved"></i> لوحة التحكم</a></li>
        </ul>
        <div class="hamburger" id="hamburger" onclick="toggleMobileNav()">
            <span></span><span></span><span></span>
        </div>
    </div>
</nav>

<!-- Mobile Nav -->
<div class="mobile-nav" id="mobile-nav">
    <a href="#home" onclick="closeMobileNav()"><i class="fa-solid fa-house"></i> الرئيسية</a>
    <a href="#install" onclick="closeMobileNav()"><i class="fa-solid fa-terminal"></i> طريقة التنصيب</a>
    <a href="#deploy" onclick="closeMobileNav()"><i class="fa-solid fa-cloud-arrow-up"></i> التشغيل السريع</a>
    <a href="#features" onclick="closeMobileNav()"><i class="fa-solid fa-bolt"></i> المميزات</a>
    <a href="#developer" onclick="closeMobileNav()"><i class="fa-solid fa-user-ninja"></i> المطور</a>
    <button onclick="openOwnerModal(event);closeMobileNav()"><i class="fa-solid fa-shield-halved"></i> لوحة التحكم</button>
