        const cur=document.getElementById('current-pass').value;
        const nw=document.getElementById('new-pass').value;
        if(cur!==ownerPassword){showToast('❌ كلمة المرور الحالية غير صحيحة!','error');return}
        if(nw.trim()){ownerPassword=nw;showToast('✅ تم تحديث كلمة المرور بنجاح!','success')}
        else{showToast('ℹ️ لم تُدخل كلمة مرور جديدة','info')}
        document.getElementById('current-pass').value='';document.getElementById('new-pass').value='';return;
    }
    const name=document.getElementById('input-bot-name').value.trim();
    const desc=document.getElementById('input-bot-desc').value.trim();
    const img=document.getElementById('input-bot-img').value.trim();
    const phone=document.getElementById('input-bot-phone').value.trim();
    const git=document.getElementById('input-git-link').value.trim();
    const chan=document.getElementById('input-chan-link').value.trim();
    const sess=document.getElementById('input-session-url').value.trim();
    const dep=document.getElementById('input-deploy-url').value.trim();
    const vid=document.getElementById('input-video-url').value.trim();
    if(name){document.getElementById('bot-title').innerText=name;
             document.getElementById('main-logo').querySelector('span').innerText='⚡ '+name;
             document.getElementById('footer-logo').innerText='⚡ '+name+' ⚡';}
    if(desc)document.getElementById('bot-desc').innerText=desc;
    if(img)document.getElementById('hero-image').src=img;
    if(git){document.getElementById('btn-github-link').href=git;document.getElementById('install-github-link').href=git;}
    if(chan)document.getElementById('btn-wa-link').href=chan;
    if(phone)document.getElementById('dev-contact-link').href='https://wa.me/'+phone.replace('+','');
    if(sess){document.getElementById('session-btn-link').href=sess;document.getElementById('session-btn-link2').href=sess;}
    if(dep){document.getElementById('deploy-btn-link').href=dep;document.getElementById('deploy-btn-link2').href=dep;}
    if(vid){
        const v=document.getElementById('hero-video');
        const p=document.getElementById('video-placeholder');
        v.src=vid;v.style.display='block';p.style.display='none';
    }
    showToast('✅ تم حفظ كافة الإعدادات بنجاح!','success');
}

/* TOAST */
function showToast(msg,type){
    const t=document.createElement('div');
    t.style.cssText='position:fixed;bottom:110px;left:50%;transform:translateX(-50%);padding:13px 24px;border-radius:12px;font-size:14px;font-family:Tajawal,sans-serif;z-index:9999;backdrop-filter:blur(10px)';
    t.style.background=type==='error'?'rgba(255,77,109,.9)':type==='info'?'rgba(79,172,254,.9)':'rgba(0,242,254,.9)';
    t.style.color='#000';t.style.fontWeight='700';t.innerText=msg;
    document.body.appendChild(t);setTimeout(()=>t.remove(),3000);
}

/* EYE TOGGLE */
function toggleEye(id,btn){
    const inp=document.getElementById(id);
    const icon=btn.querySelector('i');
    inp.type=inp.type==='password'?'text':'password';
    icon.className=inp.type==='password'?'fa-solid fa-eye':'fa-solid fa-eye-slash';
}

/* AI CHAT */
function toggleAIChat(){
    const c=document.getElementById('ai-chat-widget');
    c.style.display=c.style.display==='flex'?'none':'flex';
}
function sendAIMessage(){
    const inp=document.getElementById('ai-chat-input');
    const box=document.getElementById('ai-chat-messages');
    const text=inp.value.trim();if(!text)return;
    box.innerHTML+=`<div class="message user">${text}</div>`;inp.value='';box.scrollTop=box.scrollHeight;
    setTimeout(()=>{
        const q=text.toLowerCase();
        let r="أنا مساعد OSKA-BOT. لتنصيب البوت راجع قسم 'طريقة التنصيب' أعلى الصفحة للتفاصيل الكاملة!";
        if(q.includes('session')||q.includes('جلسة'))r="للحصول على Session ID: اضغط 'احصل على الجلسة' في قسم التنصيب → أدخل رقم الواتساب → امسح QR Code → انسخ الكود.";
        else if(q.includes('koyeb')||q.includes('deploy')||q.includes('رفع'))r="للرفع على Koyeb: أنشئ حساباً مجانياً → ابدأ مشروعاً من GitHub → أضف SESSION_ID في متغيرات البيئة → انشر!";
        else if(q.includes('مطور')||q.includes('مساعدة'))r="تواصل مع المطور AYOUB عبر زر 'تواصل عبر واتساب' في قسم المطور.";
        else if(q.includes('مرحبا')||q.includes('سلام'))r="أهلاً بك يا بطل! كيف أخدمك اليوم في عالم OSKA-BOT؟ ⚡";
        box.innerHTML+=`<div class="message bot">${r}</div>`;box.scrollTop=box.scrollHeight;
    },700);
}

/* MUSIC */
const audio=document.getElementById('bg-audio');
function toggleMusic(){
    const btn=document.getElementById('play-pause-btn').querySelector('i');
    if(audio.paused){audio.play();btn.className='fa-solid fa-pause';}
    else{audio.pause();btn.className='fa-solid fa-play';}
}

/* ACTIVE NAV */
window.addEventListener('scroll',()=>{
    const ids=['home','install','deploy','features','developer'];
    let cur='';
    ids.forEach(id=>{const el=document.getElementById(id);if(el&&window.scrollY>=el.offsetTop-120)cur=id});
    document.querySelectorAll('.nav-links a').forEach(a=>{
        a.classList.remove('active');
        if(a.getAttribute('href')==='#'+cur)a.classList.add('active');
    });
});
